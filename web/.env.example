# Copy to .env.local and fill in. The web firebaseConfig is not secret (it ships in every web app).
VITE_FIREBASE_CONFIG={"apiKey":"...","authDomain":"PROJECT.firebaseapp.com","projectId":"PROJECT","storageBucket":"PROJECT.firebasestorage.app","messagingSenderId":"...","appId":"..."}
# reCAPTCHA Enterprise site key for App Check (production). Leave empty locally and use a debug token.
VITE_RECAPTCHA_ENTERPRISE_KEY=
# For local dev / judges: "true" prints a debug token in the console; or paste a registered token.
VITE_APPCHECK_DEBUG=true
VITE_APPCHECK_DEBUG_TOKEN=
VITE_INCIDENT_ID=demo-riverside
